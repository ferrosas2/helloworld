# =============================================================================
# Environment Variables: Streaming Fraud Detection
# =============================================================================
# Copy this file to .env and fill in your GCP resource IDs.
# NEVER commit .env to source control.
# =============================================================================

# GCP Core
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Pub/Sub
PUBSUB_TOPIC_TRANSACTIONS=pos-transactions
PUBSUB_SUBSCRIPTION_TRANSACTIONS=pos-transactions-dataflow-sub
PUBSUB_TOPIC_FLAGGED=flagged-transactions

# BigQuery
BQ_DATASET=fraud_detection
BQ_TABLE_TRANSACTIONS=enriched_transactions

# Vertex AI Online Prediction (fraud classifier)
VERTEX_PREDICTION_ENDPOINT_ID=your-prediction-endpoint-id

# Vertex AI Vector Search (deep analysis RAG path)
VERTEX_INDEX_ID=your-vector-search-index-id
VERTEX_ENDPOINT_ID=your-vector-search-endpoint-id

# Cloud Storage
GCS_BUCKET_NAME=your-fraud-detection-bucket

# LLM Configuration
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1024

# Scoring Thresholds
HIGH_RISK_THRESHOLD=0.7
MEDIUM_RISK_THRESHOLD=0.3

# Dataflow
DATAFLOW_TEMP_LOCATION=gs://your-bucket/temp
DATAFLOW_MAX_WORKERS=20
VELOCITY_WINDOW_SECONDS=300

# Service
SERVICE_NAME=streaming-fraud-detection
LOG_LEVEL=INFO
